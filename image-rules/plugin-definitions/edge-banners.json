{
  "id": "edge-banners",
  "version": 8,
  "meta": {
    "name": "去除包子漫画横幅",
    "description": "自动识别并去除漫画图片顶部、底部的包子漫画广告横幅，支持多条叠加横幅，也适用于转载这些图片的其他书源。",
    "website": "https://github.com/honjow/koma-sources"
  },
  "processor": {
    "abi": "koma-image-v1",
    "wasm": "../plugins/target/wasm32-unknown-unknown/release/koma_image_banner.wasm"
  },
  "parametersFromRule": "../definitions/edge-banners.json",
  "application": {
    "automatic": true,
    "sourceHints": [
      {
        "kind": "baozi_banner",
        "modes": [
          "1",
          "2"
        ],
        "sourceIds": [
          "online.baozimh.koma"
        ]
      }
    ]
  },
  "output": {
    "format": "image/jpeg",
    "quality": 90
  }
}
