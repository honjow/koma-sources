  "localization": {
    "version": 1,
    "defaultLocale": "zh-Hans",
    "messages": {
      "source.description": {
        "zh-Hans": "巴卡以中文翻译的韩国条漫为主，有独立的 BL 区，也收录英文版和全年龄作品。部分新章与外传需站点账号。",
        "zh-Hant": "巴卡以中文翻譯的韓國條漫為主，有獨立的 BL 區，也收錄英文版和全年齡作品。部分新章與外傳需本站帳號。",
        "en": "Baka Manga focuses on Chinese-translated Korean webcomics, with a dedicated BL section alongside English and all-ages titles. Some new and side-story chapters require a site account."
      }
    }
  }
}
