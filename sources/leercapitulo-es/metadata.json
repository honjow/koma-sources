  "localizedDescriptions": {
    "zh-Hans": "西班牙语漫画站，收录《ONE PIECE》《Nano máquina》等日漫、韩漫和国漫，并按题材与主题分类。",
    "zh-Hant": "西班牙語漫畫站，收錄《ONE PIECE》《Nano máquina》等日漫、韓漫和國漫，並依題材與主題分類。",
    "en": "Spanish manga, manhwa and manhua, including One Piece and Nano máquina, with genre and theme catalogues.",
    "ja": "『ONE PIECE』『Nano máquina』などの日本・韓国・中国の漫画を、ジャンルやテーマごとに探せるスペイン語サイト。",
    "ko": "One Piece와 Nano máquina 등 일본·한국·중국 만화를 장르와 테마로 분류한 스페인어 사이트입니다."
  },
  "requestLimits": [
    {
      "group": "leercapitulo-es-site",
      "permits": 1,
      "periodMs": 3000,
      "hosts": [
        "www.leercapitulo.co"
      ]
    }
  ],
