  "comments": {"version": 1, "scopes": ["manga"]},
  "homepage": "https://www.bilimanga.net",
  "chapterOrder": "newest_first",
  "requestLimits": [
    {
      "group": "all",
      "permits": 10,
      "periodMs": 10000,
      "setting": {
        "key": "RATE_LIMIT",
        "windowValue": true,
        "keepUntilRestart": true
      }
    }
  ],
  "websitePolicy": {
    "responseUrlOrigins": ["https://www.bilimanga.net"],
    "webSessionReadySelector": ".book-detail-btn #btnReadBook, #pagelink, a.book-layout",
