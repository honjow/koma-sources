      {
        "origin": "https://www.bilimanga.net",
        "name": "night",
        "values": [
          "1"
        ]
      }
    ]
  },
  "localization": {
    "version": 1,
    "defaultLocale": "zh-Hant",
    "messages": {
      "source.description": {
        "zh-Hans": "bilimanga.net 的中文译漫站，能找到《王者天下》《学生会也有洞！》等日漫，还有单独的周荐榜、周鲜花榜和新书榜。",
        "zh-Hant": "bilimanga.net 的中文譯漫站，能找到《王者天下》《學生會也有洞！》等日漫，另有每週推薦榜、鮮花榜和新書榜。",
        "en": "A Chinese-language manga site with series such as Kingdom and There's a Hole in the Student Council Too!, plus separate weekly recommendation, flower-vote and new-title charts."
      }
    }
  }
}
