        "origin": "https://www.bilimanga.net",
        "name": "night",
        "values": [
          "1"
        ]
      }
    ]
  },
  "localization": {
    "version": 1,
    "defaultLocale": "zh-Hant",
    "messages": {
      "source.description": {
        "zh-Hant": "嗶哩漫畫（bilimanga.net）收錄日本、韓國、港台、歐美與大陸漫畫，涵蓋奇幻冒險、校園戀愛及懸疑驚悚等題材。",
        "zh-Hans": "哔哩漫画（bilimanga.net）收录日本、韩国、港台、欧美与大陆漫画，涵盖奇幻冒险、校园恋爱及悬疑惊悚等题材。",
        "en": "BiliManga (bilimanga.net) carries Asian and Western comics in fantasy, adventure, romance and suspense."
      }
    }
  }
}
