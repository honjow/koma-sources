{
  "localizedNames": {
    "zh-Hans": "优酷漫画",
    "zh-Hant": "優酷漫畫",
    "en": "YKMH"
  },
  "homepage": "https://www.ykmh.net",
  "websitePolicy": {
    "webFetchBridge": true,
    "renderedDocumentFallback": {
      "readySelector": "li.list-comic a.comic_img, li.list-comic a.txtA, div.itemBox .itemTxt > a.title, div.comic_deCon > h1, #comicName, .head_title h2"
    }
  },
  "chapterOrder": "oldest_first",
  "requestLimits": [
    {
      "group": "ykmh-public",
      "permits": 2,
      "periodMs": 1000,
      "hosts": [
        "www.ykmh.net",
        "m.ykmh.net"
      ]
    }
  ]
}
