  "icon": "icon.png",
  "homepage": "https://pocket.shonenmagazine.com/",
  "minAppVersion": "1.5.5",
  "localizedNames": {
    "zh-Hans": "Magazine Pocket（讲谈社）",
    "zh-Hant": "Magazine Pocket（講談社）",
    "en": "Magazine Pocket",
    "ja": "マガポケ",
    "ko": "매거진 포켓"
  },
  "localizedDescriptions": {
    "zh-Hans": "讲谈社官方漫画平台，收录《蓝色监狱》等 Magazine 连载和平台原创。可阅读官网公开话。",
    "zh-Hant": "講談社官方漫畫平台，收錄《BLUE LOCK 藍色監獄》等 Magazine 連載和平台原創。可閱讀官網公開話。",
    "en": "Kodansha’s official home for Magazine series such as BLUE LOCK and Magazine Pocket originals. Public episodes are available to read.",
    "ja": "講談社の公式漫画サービス。『ブルーロック』などのマガジン作品とマガポケオリジナルを、公開話の範囲で読めます。",
    "ko": "고단샤 공식 만화 서비스입니다. 《블루 록》 등 매거진 연재작과 매거진 포켓 오리지널의 공개 회차를 읽을 수 있습니다."
  },
  "requiredImageDecodes": [
    "wasm_image_v1"
  ],
  "wasmBuild": {
    "imageProcessorCrate": "koma_magazinepocket_tiles_processor"
  },
  "requestLimits": [
    {
      "group": "magazinepocket-api",
      "permits": 5,
      "periodMs": 1000,
      "hosts": [
        "api.pocket.shonenmagazine.com"
      ]
    }
  ],
