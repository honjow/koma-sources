{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Koma Source Manifest",
  "type": "object",
  "required": ["id", "name", "version", "lang", "icon"],
  "properties": {
    "icon": {
      "type": "string",
      "enum": ["icon.png", "icon.jpg", "icon.jpeg", "icon.gif", "icon.webp", "icon.ico"],
      "description": "Required local root identity asset; exactly one must exist and match this filename."
    },
    "id": { "type": "string", "description": "Unique source identifier (e.g. baozimh, mangadex)" },
    "name": { "type": "string", "description": "Human-readable display name" },
    "version": { "type": "string", "description": "Semver version string" },
    "lang": { "type": "string", "description": "Language code: zh, en, ja, multi, etc." },
    "nsfw": { "type": "boolean", "default": false },
    "minAppVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "description": "Minimum Koma app version required (MAJOR.MINOR.PATCH)"
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "contentRating": { "type": "string", "description": "Source-wide content rating" },
    "homepage": { "type": "string" },
    "localizedNames": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 63,
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,5}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "Optional locale-to-display-name map. Packaging also enforces case-insensitive key uniqueness, trimmed names, no U+0000..001F/U+007F, and at most 128 UTF-16 code units. Empty maps are preserved."
    }
  }
}
