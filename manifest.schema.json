{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Koma Source Manifest",
  "type": "object",
  "required": ["id", "name", "version", "lang", "icon"],
  "properties": {
    "icon": {
      "type": "string",
      "enum": ["icon.png", "icon.jpg", "icon.jpeg", "icon.gif", "icon.webp", "icon.ico"],
      "description": "Required local root identity asset; exactly one must exist and match this filename."
    },
    "id": { "type": "string", "description": "Unique source identifier (e.g. baozimh, mangadex)" },
    "name": { "type": "string", "description": "Human-readable display name" },
    "version": { "type": "string", "description": "Semver version string" },
    "lang": { "type": "string", "description": "Language code: zh, en, ja, multi, etc." },
    "nsfw": { "type": "boolean", "default": false },
    "wasmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requiredImageDecodes": {
      "type": "array",
      "maxItems": 1,
      "items": { "enum": ["jm_stripes_v1", "wasm_image_v1"] }
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "description": "Minimum Koma app version required (MAJOR.MINOR.PATCH)"
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "contentRating": { "type": "string", "description": "Source-wide content rating" },
    "homepage": { "type": "string" },
    "comments": {
      "type": "object",
      "description": "Optional read-only comment capability supplied by the installed source.",
      "required": ["version", "scopes"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["manga", "chapter"] } }
      }
    },
    "mihonImport": {
      "type": "object",
      "required": ["sourceIds", "work"],
      "properties": {
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^-?[0-9]{1,19}$" } },
        "work": { "type": "object", "required": ["pathPrefix", "idPrefix"] },
        "chapter": { "type": "object", "required": ["pathPrefix", "idPrefix"] },
        "samePageOrder": { "type": "boolean" }
      }
    },
    "webSessionOrigins": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?$" },
      "description": "Optional exact HTTPS origins eligible for an explicitly authorized host WebView session; never a cookie value or wildcard."
    },
    "requestLimits": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["group", "permits", "periodMs"],
        "properties": {
          "group": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
          "permits": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "periodMs": { "type": "integer", "minimum": 1, "maximum": 2147483647000 },
          "hosts": { "type": "array", "maxItems": 16, "items": { "type": "string" } },
          "firstLabels": { "type": "array", "maxItems": 8, "items": { "type": "object" } },
          "requestHeaders": { "type": "array", "maxItems": 16, "items": { "type": "string" } },
          "perOrigin": { "type": "boolean" },
          "oncePerRequest": { "type": "boolean" },
          "setting": { "type": "object" }
        }
      }
    },
    "websitePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homepageChoices": { "type": "object" },
        "httpProfiles": { "type": "array" },
        "webSessionReadySelector": { "type": "string", "minLength": 1, "maxLength": 256 },
        "systemWebAgentOrigins": { "type": "array" },
        "mobileWebAndroidAgentOrigins": { "type": "array" },
        "publicCookieOverrides": { "type": "array" },
        "guestHttp": { "type": "object" },
        "responseUrlOrigins": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/properties/webSessionOrigins/items" }
        },
        "dnsBootstrap": { "type": "object" },
        "preserveRouteCover": { "type": "boolean" },
        "routeCoverPlaceholderSuffix": { "type": "string" },
        "chapterIdentity": {
          "type": "object",
          "description": "Chapter ID compatibility wire field. Authors declare identity.chapter in metadata.json."
        },
        "publicWorkUrlDomains": { "type": "array" }
      }
    },
    "presentation": {
      "type": "object",
      "description": "Optional static display projection of the source localization catalog. Grants no UI or authentication capability.",
      "required": ["version", "texts"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "defaultLocale": {
          "type": "string", "maxLength": 63,
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,5}$"
        },
        "texts": {
          "type": "object",
          "propertyNames": { "enum": ["name", "description", "author", "authentication.usernameLabel", "authentication.passwordLabel"] },
          "additionalProperties": {
            "type": "object", "maxProperties": 16,
            "propertyNames": { "type": "string", "maxLength": 63, "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,5}$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "localizedNames": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 63,
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,5}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "Optional locale-to-display-name map. Packaging also enforces case-insensitive key uniqueness, trimmed names, no U+0000..001F/U+007F, and at most 128 UTF-16 code units. Empty maps are preserved."
    }
  }
}
